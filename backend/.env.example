PORT=5000
# Local demo: true starts a temporary MongoDB that resets whenever the backend stops.
# For persistent storage, set USE_MEMORY_DB=false and configure MONGODB_URI instead.
USE_MEMORY_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_app
JWT_SECRET=replace-with-a-long-random-secret
# Optional; manager sign-up is disabled unless this is set.
MANAGER_SIGNUP_CODE=
